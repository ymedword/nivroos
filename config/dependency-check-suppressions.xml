<!-- OWASP Dependency-Check 误报抑制。
     新增抑制时：suppress 元素内必须注明 CVE 编号与误报理由（审计要求），不裸抑制。
     示例：
     <suppress>
       <notes><![CDATA[CVE-xxxx-xxxx 误报：xxx 仅影响官方 UI，NivroOS 不使用该模块]]></notes>
       <cve>CVE-xxxx-xxxx</cve>
     </suppress>

     评审记录：2026-08-31 用户评审本文件全部 8 组抑制（US-1 交付），决议：
     核心阶段接受风险（内网部署假设 + 抑制路径不执行）；【发布前必须执行】
     依赖升级专项（Spring AI / Boot 版本线配套重测），完成后逐组复核并移除仍适用的抑制。
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- CVE-2023-39022：CPE 误报。该 CVE 对应 JavaScript 包（import-in-the-middle），
         dependency-check 按 CPE 启发式误匹配到本项目内部模块（2026-08-27 实测）。 -->
    <suppress>
        <notes><![CDATA[CPE false positive: CVE-2023-39022 affects a JavaScript package (import-in-the-middle); heuristic CPE match against the internal module jar]]></notes>
        <gav regex="true">^com\.nivroos:nivroos-core:.*$</gav>
        <cve>CVE-2023-39022</cve>
    </suppress>

    <!-- Spring AI 1.1.2 系列 CVE（spring-ai-model / deepseek / rag / starter 等）：
         版本矩阵宪法级锁定（spring-ai 1.1.2 ↔ spring-ai-alibaba 1.1.2.3 ↔ Boot 3.5.16
         配套实测 2026-08-27）。升级或调整依赖图需配套重测，属软门禁事项，待评审决议。
         核心阶段仅使用 ChatModel 协议转换路径，不触碰 RAG/文档解析能力。 -->
    <suppress>
        <notes><![CDATA[Spring AI 1.1.2 is locked by the version matrix (verified pairing with spring-ai-alibaba 1.1.2.3 / Boot 3.5.16); upgrading or reshaping the dependency graph needs re-verification (soft gate, pending review). Core stage uses only the ChatModel protocol-conversion path]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.ai/[^@]+@1\.1\.2$</packageUrl>
        <cve>CVE-2026-22729</cve>
        <cve>CVE-2026-22730</cve>
