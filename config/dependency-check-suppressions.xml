    <!-- kotlin-stdlib 1.9.25：传递依赖（spring-ai 生态）。NivroOS 代码无 Kotlin 用法，
         升级传递依赖版本需依赖图调整并配套重测，属软门禁事项，待评审决议。 -->
    <suppress>
        <notes><![CDATA[Transitive Kotlin stdlib (Spring AI ecosystem); NivroOS has no Kotlin code. Bumping the transitive version reshapes the dependency graph and needs review (soft gate)]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-stdlib[^@]*@1\.9\.25$</packageUrl>
        <cve>CVE-2026-53914</cve>
    </suppress>

