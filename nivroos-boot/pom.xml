<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nivroos</groupId>
        <artifactId>nivroos</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>nivroos-boot</artifactId>
    <name>NivroOS Boot</name>
    <description>Spring Boot bootstrap module — produces the executable fat JAR (nivroos serve).</description>

    <dependencies>
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-provider</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-tool</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-channel-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-storage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-cli</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.nivroos.NivroOsApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
