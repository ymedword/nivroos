<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nivroos</groupId>
        <artifactId>nivroos</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>nivroos-cli</artifactId>
    <name>NivroOS CLI</name>
    <description>Picocli entry point: 12 subcommands, ConfigLoader with ${ENV_VAR} secret injection.</description>

    <dependencies>
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-channel-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-storage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- ChatCommand 组装工具池需要 Sandbox/HttpTools（内部模块依赖，US-2 新增） -->
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-tool</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- ChatCommand 需要构造 MemoryTools 并注入 MemoryService（US-3 新增） -->
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
