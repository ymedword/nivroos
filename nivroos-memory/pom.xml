<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nivroos</groupId>
        <artifactId>nivroos</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>nivroos-memory</artifactId>
    <name>NivroOS Memory</name>
    <description>Capability 3 — three-layer memory: MemoryService facade, LongTermMemory (MEMORY.md), MemoryTools.</description>

    <dependencies>
        <dependency>
            <groupId>com.nivroos</groupId>
            <artifactId>nivroos-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- SqliteMemoryStore 的 JdbcTemplate（版本由 Boot BOM 管理，非新增第三方坐标） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <!-- @ConfigurationProperties / @EnableConfigurationProperties（MemoryProperties） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <!-- SpotBugs 局部抑制注解（provided，不进运行时；同 core/provider 先例） -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SqliteMemoryStoreTest 用内存/临时库（根 POM 已锁 3.53.2.1） -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
